// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status  UserStatus @default(Inactive)

  isEmailVerified Boolean @default(false)

  emailVerificationToken  String?
  emailVerificationExpiry DateTime?

  pendingEmail            String?
  pendingEmailToken       String?
  pendingEmailTokenExpiry DateTime?

  passwordResetToken      String?
  passwordResetTokenExpiry DateTime?

  sites Site[]
  subscription Subscription?
  paymentRequests PaymentRequest[]
  subscriptionHistory SubscriptionHistory[]

  @@index([emailVerificationToken])
  @@index([pendingEmailToken])
  @@index([passwordResetToken])
}

model Site {
  id        String   @id @default(uuid())
  name      String
  domain    String
  apiKey    String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  events Event[]

  @@index([userId])
}

model Event {
  id          String    @id @default(uuid())
  type        EventType
  pageUrl     String
  referrer    String?
  productId   String?
  productName String?
  visitorId   String
  siteId      String
  createdAt   DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id])

  @@index([siteId, createdAt])
  @@index([siteId, productId])
  @@index([siteId, visitorId])
}

model adminLog {
  id String @id @default(uuid())
  adminId String
  action String
  targetedUserId String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetedUserId])
}

model Admin {
  id                String    @id @default(uuid())
  fullName          String?
  email             String    @unique
  password          String?
  role              AdminRole @default(ADMIN)
  isActive          Boolean   @default(false)
  inviteToken       String?
  inviteTokenExpiry DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum EventType {
  PAGE_VIEW
  PRODUCT_CLICK
}

enum UserStatus {
  Active
  Inactive
  Banned
  Deleted
}

model Subscription {
  id               String   @id @default(uuid())
  userId           String   @unique
  plan             Plan     @default(Free)
  status           SubscriptionStatus @default(Active)
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  // Set by a user-initiated cancel (POST /billing/cancel): the plan doesn't
  // change immediately — there's no payment processor here to prorate a
  // refund through, so instead access is kept at the current (paid) plan
  // until currentPeriodEnd, and only then does the lazy-expiry check in
  // subscription.service.js apply pendingPlan instead of just falling back
  // to Free. Admin-initiated downgrades bypass this entirely and stay
  // immediate — that's still the tool for cause (non-payment, abuse).
  pendingPlan      Plan?
  // Set alongside plan/status by setUserPlanService and payment-request
  // approval. Nullable because Free has no cycle. Previously computed once
  // to derive currentPeriodEnd and then thrown away — persisted now so
  // renewals/reporting can see what cycle a user is actually on.
  billingCycle     BillingCycle?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// One row per real subscription change (admin plan-set, lazy expiry
// applying, a self-service cancel taking effect) — a lightweight audit /
// billing-history trail. Not the same table as Subscription itself: that
// one only ever holds the current state, this one accumulates every state
// it's passed through.
model SubscriptionHistory {
  id               String   @id @default(uuid())
  userId           String
  plan             Plan
  billingCycle     BillingCycle?
  status           SubscriptionStatus
  currentPeriodEnd DateTime?
  // adminId of whoever made the change, or null when the system did it
  // (lazy expiry, a scheduled cancel finally applying).
  changedBy        String?
  reason           String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// A user's claim of having sent a bank transfer, submitted from
// BillingPay.jsx alongside (not instead of) the WhatsApp message — WhatsApp
// remains the actual notification channel, this is what makes that claim
// visible and actionable inside the admin panel instead of living only in
// a chat thread. Approving one calls the same setUserPlanService path an
// admin manually setting a plan does, so there's exactly one place that
// actually mutates a Subscription.
model PaymentRequest {
  id           String   @id @default(uuid())
  userId       String
  plan         Plan
  billingCycle BillingCycle
  status       PaymentRequestStatus @default(Pending)
  note         String?
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
  // Distinct from `note` above (that one's the user's own submission note,
  // e.g. a transfer reference) — this is the admin's reason for approving
  // or, more usefully, rejecting, surfaced back to the user in the review
  // email (see billing/email templates).
  reviewNote   String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

enum PaymentRequestStatus {
  Pending
  Approved
  Rejected
}

enum BillingCycle {
  monthly
  yearly
}

enum SubscriptionStatus {
  Active
  Trialing
  PastDue
  Canceled
  Paused
}

enum Plan {
  Free
  Pro
  Business
}
